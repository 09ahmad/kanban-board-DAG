  async generateSuggestions(projectId, taskId, requesterId):
  // 1. Load project tasks
  // 2. AWAIT aiProvider.generateDependencySuggestions(...) directly in-request — may return
  //    [] on failure. This call is synchronous from the caller's perspective; there is no
  //    job queue, no aiQueue, no worker process for this.
