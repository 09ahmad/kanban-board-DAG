# node_modules must stay IN the context: the Dockerfiles COPY the host's
# complete node_modules instead of running `bun install` (bun's registry
# operations stall inside Docker build containers). Docker's content store
# dedupes the identical node_modules layer shared by the backend images.

.git
.gitignore
.github

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

dist
build
.next
out
.turbo
coverage
.nyc_output
*.tsbuildinfo

.env
.env.*
!.env.example
!.env.production.example

.vscode
.idea
.DS_Store
Thumbs.db

docker-compose.override.yml

docs
**/*.md
!package.json

tmp
temp
*.tmp
*.pem
.vercel
.netlify

**/*.test.ts
**/*.test.tsx
**/__tests__
