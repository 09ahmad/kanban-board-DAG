# TaskFlow Pro - Docker Ignore
# Files and directories to exclude from Docker build context

# Git
.git
.gitignore

# Node.js / Bun
node_modules
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist
build
.next
out
.turbo

# Environment files
.env
.env.local
.env.production.local
.env.development.local
.env.test.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage
.nyc_output

# Docker
docker-compose.override.yml
Dockerfile*
docker/
*.dockerignore

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Prisma
# NOTE: migrations are NOT ignored — db-init Dockerfile needs them

# TypeScript
*.tsbuildinfo

# Misc
*.pem
.vercel
.netlify