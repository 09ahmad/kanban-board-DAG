# Keep the build context small. Each image copies only the workspace
# package.json files it needs, then `bun install` (not the full Next.js tree).

.git
.gitignore
.github

node_modules
**/node_modules
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

dist
build
.next
out
.turbo
coverage
.nyc_output
*.tsbuildinfo

.env
.env.*
!.env.example
!.env.production.example

.vscode
.idea
.DS_Store
Thumbs.db

docker-compose.override.yml

docs
**/*.md
!package.json

tmp
temp
*.tmp
*.pem
.vercel
.netlify

**/*.test.ts
**/*.test.tsx
**/__tests__
