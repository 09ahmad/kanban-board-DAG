DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379
PORT=4000
WS_PORT=4001
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars
# How long a login lasts. No refresh token exists, so this is the whole session.
# A number is seconds; a suffix is a duration (12h, 30d).
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
# BullMQ queue name for background AI suggestion runs. Point tests at their own
# queue so a running dev server's worker cannot consume their jobs.
AI_SUGGESTIONS_QUEUE=ai-suggestions