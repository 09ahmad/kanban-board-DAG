# TaskFlow Pro - Production Environment Variables
# Copy this to .env and fill in your values for production deployment

# Database
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=taskflow

# JWT Secret - MUST be at least 32 characters in production
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# CORS Origin - Set to your production domain
CORS_ORIGIN=https://yourdomain.com

# AI Service (Optional) - Add OpenAI API key to enable AI suggestions
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Public URLs for frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws

# Node Environment
NODE_ENV=production