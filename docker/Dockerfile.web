# syntax=docker/dockerfile:1
# Next.js: dependencies are copied from the host instead of running
# `bun install` here: bun's registry operations stall inside Docker build
# containers. The build itself runs under Node, not Bun — `next build`
# (Next 16 Turbopack runtime) fails to load its compiled modules under Bun.
# The Node slim runner serves the standalone output.
FROM node:24-bookworm-slim AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY node_modules ./node_modules
COPY package.json ./
COPY packages/types ./packages/types
COPY packages/ui ./packages/ui
COPY packages/eslint-config ./packages/eslint-config
COPY packages/typescript-config ./packages/typescript-config
COPY apps/web ./apps/web

ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL=/ws
ARG API_INTERNAL_URL=http://server:4000
ARG WS_INTERNAL_URL=http://ws-server:4001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    API_INTERNAL_URL=$API_INTERNAL_URL \
    WS_INTERNAL_URL=$WS_INTERNAL_URL \
    NEXT_STANDALONE=true

WORKDIR /app/apps/web
RUN node /app/node_modules/next/dist/bin/next build

FROM node:24-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["node", "server.js"]
