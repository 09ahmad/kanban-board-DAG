# Dockerfile for TaskFlow Pro Web Frontend (Next.js)
# Multi-stage build: builder for dependencies and build, production for running
# Uses Node.js 20 with bun for lockfile compatibility
FROM node:20-alpine AS builder

# Install bun globally for lockfile compatibility
RUN npm install -g bun@1.2.19

WORKDIR /app

# Copy root workspace configuration files
COPY package.json bun.lock turbo.json bunfig.toml ./

# Copy package.json files for all workspace members (needed for bun install)
COPY packages/db/package.json ./packages/db/
COPY packages/queue/package.json ./packages/queue/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY apps/web/package.json ./apps/web/

# Install all dependencies (including devDependencies for building)
RUN bun install

# Copy all package source code required for monorepo build
COPY packages/db ./packages/db
COPY packages/queue ./packages/queue
COPY packages/types ./packages/types
COPY packages/ui ./packages/ui
COPY packages/eslint-config ./packages/eslint-config
COPY packages/typescript-config ./packages/typescript-config

# Copy web app source
COPY apps/web ./apps/web

# Build the Next.js app with required build-time environment variables
# These are baked into routes-manifest.json for the reverse-proxy rewrites
WORKDIR /app/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_WS_URL=/ws
ENV API_INTERNAL_URL=http://server:4000
ENV WS_INTERNAL_URL=http://ws-server:4001
RUN npx next build

# --- Production stage ---
# Next.js `output: 'standalone'` creates a self-contained server bundle at
# .next/standalone/ — no separate `npm install` is needed in production.
FROM node:20-alpine AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copy the standalone server bundle (includes all node_modules it needs)
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/standalone ./

# Copy static assets into the expected paths under the standalone server root
# Next.js standalone serves these from .next/static and public/
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/public ./apps/web/public

USER nodejs

EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

# The standalone bundle's entry point is server.js in the standalone root
WORKDIR /app/apps/web
CMD ["node", "server.js"]