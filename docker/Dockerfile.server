# syntax=docker/dockerfile:1
# REST API. Workspace install is only the API graph (no Next.js / Turbo).
FROM oven/bun:1.2.19

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
COPY apps/server/package.json ./apps/server/
COPY packages/db/package.json ./packages/db/
COPY packages/queue/package.json ./packages/queue/
COPY packages/types/package.json ./packages/types/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN bun -e 'const p=await Bun.file("package.json").json(); p.workspaces=["apps/server","packages/db","packages/queue","packages/types","packages/typescript-config"]; p.devDependencies={}; await Bun.write("package.json", JSON.stringify(p,null,2))'
RUN bun install

COPY apps/server ./apps/server
COPY packages/db ./packages/db
COPY packages/queue ./packages/queue
COPY packages/types ./packages/types
COPY packages/typescript-config ./packages/typescript-config

RUN cd packages/db && bunx prisma generate

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000
WORKDIR /app/apps/server
CMD ["bun", "run", "src/server.ts"]
