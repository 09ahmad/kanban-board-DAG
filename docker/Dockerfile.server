# syntax=docker/dockerfile:1
# REST API + DAG engine. Dependencies are copied from the host instead of
# running `bun install` here: bun's registry operations stall inside Docker
# build containers (workspace resolution and bulk downloads hang), while the
# host resolves the same graph in seconds. The host node_modules are complete
# (all deps hoisted to the root), glibc linux, same arch as this image.
FROM oven/bun:1.2.19

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY node_modules ./node_modules
COPY package.json ./
COPY packages/db ./packages/db
COPY packages/queue ./packages/queue
COPY packages/types ./packages/types
COPY packages/typescript-config ./packages/typescript-config
COPY apps/server ./apps/server

RUN cd packages/db && bunx prisma generate

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000
WORKDIR /app/apps/server
CMD ["bun", "run", "src/server.ts"]
