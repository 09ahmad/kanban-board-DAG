# syntax=docker/dockerfile:1
# WebSocket server (`ws` package). Dependencies are copied from the host
# instead of running `bun install` here: bun's registry operations stall
# inside Docker build containers, while the host resolves the same graph in
# seconds. Host node_modules are complete and hoisted to the root.
FROM oven/bun:1.2.19

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY node_modules ./node_modules
COPY package.json ./
COPY packages/db ./packages/db
COPY packages/queue ./packages/queue
COPY packages/types ./packages/types
COPY packages/typescript-config ./packages/typescript-config
COPY apps/ws-server ./apps/ws-server

RUN cd packages/db && bunx prisma generate

ENV NODE_ENV=production
ENV WS_PORT=4001

EXPOSE 4001
WORKDIR /app/apps/ws-server
CMD ["bun", "run", "src/index.ts"]
