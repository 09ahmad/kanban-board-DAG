# Dockerfile for TaskFlow Pro WebSocket Server
# Runs TypeScript directly with Bun (no compilation needed)
FROM oven/bun:1.2-alpine AS base

# Install runtime dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files for ws-server and its workspace dependencies
COPY package.json bun.lock turbo.json ./
COPY apps/ws-server/package.json ./apps/ws-server/
COPY packages/db/package.json ./packages/db/
COPY packages/queue/package.json ./packages/queue/
COPY packages/types/package.json ./packages/types/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# Install all dependencies (needed for workspace resolution)
RUN bun install

# Copy source code
COPY apps/ws-server ./apps/ws-server
COPY packages/db ./packages/db
COPY packages/queue ./packages/queue
COPY packages/types ./packages/types
COPY packages/typescript-config ./packages/typescript-config

# Generate Prisma client
RUN cd packages/db && bunx prisma generate

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

USER nodejs

EXPOSE 4001

ENV NODE_ENV=production
ENV WS_PORT=4001

WORKDIR /app/apps/ws-server
CMD ["bun", "run", "src/index.ts"]